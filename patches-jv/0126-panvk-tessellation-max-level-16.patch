 #define PANVK_TESS_HEAP_SIZE    (64u << 20)
 #define PANVK_TESS_MAX_INDICES  (1u << 18)
 
+/* The highest tessellation level, in maxTessellationGenerationLevel. Each patch of a draw is sized
+ * for a quad domain at this level (level x level quads of two triangles), so the buffers and the
+ * tess eval job of a draw grow with its square. src/poly/cl/tessellator.h clamps to the same. */
+#define PANVK_TESS_MAX_LEVEL    16
+
 /* The tessellator's grid for an indirect draw, whose patch count only the GPU knows: each thread
  * walks the patches at this stride. */
 #define PANVK_TESS_INDIRECT_GRID 1024
