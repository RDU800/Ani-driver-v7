+/* Diagnostics: batches and barriers, logged about once a second. */
+static uint64_t panvk_stat_batches;
+static uint64_t panvk_stat_barriers;
+static uint64_t panvk_stat_barrier_splits;
+static int64_t panvk_stat_last_ns;
+
+static void
+panvk_stats_tick(void)
+{
+   const int64_t now = os_time_get_nano();
+   const int64_t last = p_atomic_read(&panvk_stat_last_ns);
+
+   if (last == 0) {
+      p_atomic_cmpxchg(&panvk_stat_last_ns, 0, now);
+      return;
+   }
+   if (now - last < 1000000000ll)
+      return;
+   if (p_atomic_cmpxchg(&panvk_stat_last_ns, last, now) != last)
+      return;
+
+   const uint64_t batches = p_atomic_xchg(&panvk_stat_batches, 0);
+   const uint64_t barriers = p_atomic_xchg(&panvk_stat_barriers, 0);
+   const uint64_t splits = p_atomic_xchg(&panvk_stat_barrier_splits, 0);
+   mesa_logi("panvk: last %.1f s: %llu batches, %llu barriers (%llu split a batch)",
+             (double)(now - last) / 1e9, (unsigned long long)batches,
+             (unsigned long long)barriers, (unsigned long long)splits);
+}
+
