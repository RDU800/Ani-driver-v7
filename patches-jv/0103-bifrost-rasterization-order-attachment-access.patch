diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 4b939a0..e6c0b79 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -405,10 +405,20 @@ panvk_draw_prepare_fs_rsd(struct panvk_cmd_buffer *cmdbuf,
                ? PAN_EARLYZS_ZS_TILEBUF_READ_NO_OPT
                : PAN_EARLYZS_ZS_TILEBUF_NOT_READ;
 
+         /* VK_EXT_rasterization_order_attachment_access: the shader may read
+          * what earlier primitives wrote to the attachment, so pixels must not
+          * be killed by a later one (forward pixel kill) and the depth and
+          * stencil buffers are read in order. Same handling as v9 and CSF. */
+         const bool roa_color =
+            dyns->rasterization_order_access & VK_IMAGE_ASPECT_COLOR_BIT;
+         if (dyns->rasterization_order_access &
+             (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT))
+            zs_read = PAN_EARLYZS_ZS_TILEBUF_READ_NO_OPT;
+
          cfg.properties.allow_forward_pixel_to_kill =
             fs_info->fs.can_fpk && !(rt_mask & ~rt_written) &&
             !(rt_read & rt_written) && !alpha_to_coverage &&
-            !binfo->any_dest_read;
+            !binfo->any_dest_read && !roa_color;
 
          bool writes_zs = writes_z || writes_s;
          bool zs_always_passes = ds_test_always_passes(cmdbuf);
