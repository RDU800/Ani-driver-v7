index 8145449..ef65d91 100644
--- a/src/panfrost/vulkan/panvk_cmd_query.h
+++ b/src/panfrost/vulkan/panvk_cmd_query.h
@@ -30,6 +30,13 @@ struct panvk_occlusion_query_state {
 struct panvk_pipeline_stats_state {
    bool active;
    uint64_t counts[PANVK_PIPELINE_STAT_COUNT];
+
+   /* A VK_QUERY_TYPE_PRIMITIVES_GENERATED_EXT query on JM reuses the CPU counting above: it turns
+    * counting on if no pipeline statistics query did, and reports the growth of counts[6]
+    * (clipping primitives) between begin and end. Direct draws only; a geometry shader's real
+    * output count is not known on the CPU. */
+   bool pg_owns_active;
+   uint64_t pg_base;
 };
 
