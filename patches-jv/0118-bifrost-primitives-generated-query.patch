@@ -189,6 +189,15 @@ panvk_per_arch(CmdBeginQueryIndexedEXT)(VkCommandBuffer commandBuffer,
       return;
    }
 
+   /* Primitives generated are counted on the CPU like pipeline statistics (panvk_cmd_query.h). */
+   if (pool->vk.query_type == VK_QUERY_TYPE_PRIMITIVES_GENERATED_EXT) {
+      struct panvk_pipeline_stats_state *st = &cmd->state.gfx.stats;
