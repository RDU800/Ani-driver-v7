       .dst_addr = dst_addr,
       .dst_stride = dst_stride,
-      .query_type = pool->vk.query_type,
+      /* The copy kernel knows no primitives generated type; one 64-bit value plus availability
+       * is the same layout as a timestamp. */
+      .query_type = pool->vk.query_type == VK_QUERY_TYPE_PRIMITIVES_GENERATED_EXT
+                       ? VK_QUERY_TYPE_TIMESTAMP : pool->vk.query_type,
       .flags = flags,
       .report_count = pool->reports_per_query,
    };
