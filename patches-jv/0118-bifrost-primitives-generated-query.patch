+      st->active = true;
+      st->pg_base = st->counts[6];
+      return;
+   }
+
    /* Pipeline statistics are counted on the CPU and written at the end. */
    if (pool->vk.query_type == VK_QUERY_TYPE_PIPELINE_STATISTICS) {
