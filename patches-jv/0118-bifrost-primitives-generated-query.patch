       break;
    }
+   case VK_QUERY_TYPE_PRIMITIVES_GENERATED_EXT: {
+      struct panvk_pipeline_stats_state *st = &cmd->state.gfx.stats;
+      panvk_emit_write_job(cmd, batch, MALI_WRITE_VALUE_TYPE_IMMEDIATE_64,
+                           panvk_query_report_dev_addr(pool, query),
+                           st->counts[6] - st->pg_base);
+      if (st->pg_owns_active) {
+         st->active = false;
+         st->pg_owns_active = false;
+      }
+      break;
+   }
    case VK_QUERY_TYPE_PIPELINE_STATISTICS: {
       uint64_t report = panvk_query_report_dev_addr(pool, query);
       u_foreach_bit(s, pool->vk.pipeline_statistics) {
