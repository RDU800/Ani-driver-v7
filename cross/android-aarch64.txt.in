[binaries]
c = '@NDK_TOOLCHAIN@/bin/aarch64-linux-android@API@-clang'
cpp = '@NDK_TOOLCHAIN@/bin/aarch64-linux-android@API@-clang++'
ar = '@NDK_TOOLCHAIN@/bin/llvm-ar'
strip = '@NDK_TOOLCHAIN@/bin/llvm-strip'
pkg-config = 'false'
rust = ['rustc']
rust_ld = '@NDK_TOOLCHAIN@/bin/aarch64-linux-android@API@-clang'

[host_machine]
system = 'android'
cpu_family = 'aarch64'
cpu = 'armv8.2-a'
endian = 'little'

[built-in options]
rust_args = ['--target', 'aarch64-linux-android']
