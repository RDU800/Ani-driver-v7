+/* maxPushDescriptors counts API descriptors, but a combined image sampler
+ * takes a texture and a sampler slot (panvk_get_desc_stride()), so a full
+ * push set needs twice as many opaque descriptors as MAX_PUSH_DESCS. With only
+ * MAX_PUSH_DESCS slots, pushing MAX_PUSH_DESCS combined image samplers wrote
+ * past the end of the push set. */
+#define MAX_PUSH_DESC_SLOTS (MAX_PUSH_DESCS * 2)
+
 struct panvk_push_set {
    struct panvk_cmd_pool_obj base;
    struct panvk_descriptor_set set;
-   struct panvk_opaque_desc descs[MAX_PUSH_DESCS];
+   struct panvk_opaque_desc descs[MAX_PUSH_DESC_SLOTS];
 };
 
